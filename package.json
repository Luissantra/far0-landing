{
  "name": "far0-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "node --test scripts/smoke.test.mjs",
    "check": "npm run secrets:check && npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "render:video": "node scripts/landing-video/render.mjs",
    "render:intro": "node scripts/landing-video/render.mjs intro"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "secretlint": "13.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
